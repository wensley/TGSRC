# Example .env for TGSRC
# Required
API_ID=
API_HASH=
BOT_TOKEN=
OWNER_ID=123456789 987654321   # space-separated Telegram user IDs (admins)
LOG_GROUP=-1001234567890
FORCE_SUB=-1001234567890

# Encryption keys (REQUIRED)
MASTER_KEY=your_master_key_here
IV_KEY=your_iv_key_here

# Optional
REDIS_URL=redis://localhost:6379/0
STRING=
YT_COOKIES=
INSTA_COOKIES=
FREEMIUM_LIMIT=500
PREMIUM_LIMIT=500
JOIN_LINK=https://t.me/yourchannel
ADMIN_CONTACT=https://t.me/yourhandle
